# ============================================================
#  Nasil Vana Store — variáveis de ambiente
#  Copie para .env (produção) ou .env.local (desenvolvimento).
#  NUNCA commite o arquivo com valores reais.
# ============================================================

# Banco PostgreSQL 15+ (obrigatório)
DATABASE_URL=postgres://nasil:SENHA_FORTE@localhost:5432/nasil
DATABASE_SSL=false            # true para bancos gerenciados (ou use ?sslmode=require na URL)
# Serverless (Netlify) com pooler do Neon: DATABASE_POOL_MAX=3 e DATABASE_PREPARE=false
# DATABASE_POOL_MAX=10
# DATABASE_PREPARE=true

# Endereço público do site, com https e sem barra no final (obrigatório)
SITE_URL=https://www.seudominio.com.br

# Segredo interno (obrigatório, 32+ caracteres). Gere com: openssl rand -base64 48
APP_SECRET=

# ---------------- Mercado Pago (docs/PAGAMENTOS.md) ----------------
# Credencial "Access Token" (TEST-... para testes, APP_USR-... em produção)
MP_ACCESS_TOKEN=
# "Assinatura secreta" do webhook (Suas integrações → Webhooks)
MP_WEBHOOK_SECRET=
# Opcional: tolerância em segundos para o timestamp do webhook (0 = desativado)
MP_WEBHOOK_TOLERANCE_SECONDS=0

# ---------------- Imagens ----------------
STORAGE_DRIVER=local          # local (disco/volume) ou s3 (R2, S3, Supabase…)
STORAGE_LOCAL_DIR=./storage
# IMAGE_MAX_WIDTH=2000        # use 1600 na Netlify (tempo-limite das funções)
# Para S3/R2:
# S3_ENDPOINT=https://<conta>.r2.cloudflarestorage.com
# S3_BUCKET=nasil-media
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# NEXT_PUBLIC_MEDIA_BASE_URL=https://cdn.seudominio.com.br   # URL pública do bucket

# ---------------- E-mails automáticos (opcional) ----------------
# RESEND_API_KEY=
# EMAIL_FROM="Nasil Vana Store <pedidos@seudominio.com.br>"

# ---------------- Tarefa agendada (expira pedidos não pagos) ----------------
# CRON_SECRET=   # 24+ caracteres; chame GET /api/cron/expirar-pedidos com Authorization: Bearer <CRON_SECRET>

# ---------------- Google ----------------
# GOOGLE_SITE_VERIFICATION=   # só se não verificar o domínio por DNS
